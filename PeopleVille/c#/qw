using System;

public class Bank
{
    public string Name { get; set; }
    public int Money { get; private set; }
    public bool HasBankCard { get; private set; }
    public bool HasAccount { get; private set; }

    public Bank(string name, int money)
    {
        Name = name;
        Money = money;
        HasBankCard = false;
        HasAccount = false;
    }

    public void CreateAccount()
    {
        if (!HasAccount)
        {
            HasAccount = true;
            Console.WriteLine("Bankkonto oprettet.");
        }
        else
        {
            Console.WriteLine("Du har allerede en konto.");
        }
    }

    public void CheckMoney()
    {
        Console.WriteLine($"Din saldo er {Money} kr.");
    }

    public void Deposit(int amount)
    {
        if (amount > 0)
        {
            Money += amount;
            Console.WriteLine($"Du satte {amount} kr. ind.");
        }
        else
        {
            Console.WriteLine("Beløbet skal være større end 0.");
        }
    }

    public void Withdraw(int amount)
    {
        if (amount <= 0)
        {
            Console.WriteLine("Beløbet skal være større end 0.");
        }
        else if (Money >= amount)
        {
            Money -= amount;
            Console.WriteLine($"Du hævede {amount} kr.");
        }
        else
        {
            Console.WriteLine("Du har ikke nok penge.");
        }
    }

    public void GetBankCard()
    {
        if (!HasBankCard)
        {
            HasBankCard = true;
            Console.WriteLine("Du har fået et bankkort.");
        }
        else
        {
            Console.WriteLine("Du har allerede et bankkort.");
        }
    }

    public void PayBill(int amount)
    {
        if (amount <= 0)
        {
            Console.WriteLine("Beløbet skal være større end 0.");
        }
        else if (Money >= amount)
        {
            Money -= amount;
            Console.WriteLine($"Du betalte en regning på {amount} kr.");
        }
        else
        {
            Console.WriteLine("Du har ikke nok penge.");
        }
    }

    public void ShowBankCard()
    {
        if (HasBankCard)
        {
            Console.WriteLine("Du har et aktivt bankkort.");
        }
        else
        {
            Console.WriteLine("Du har ikke et bankkort.");
        }
    }

    public void ShowAccount()
    {
        if (HasAccount)
        {
            Console.WriteLine("Din konto er aktiv.");
            Console.WriteLine("Kontonummer: 123456789");
        }
        else
        {
            Console.WriteLine("Du har ingen bankkonto.");
        }
    }

    public void CloseAccount()
    {
        if (HasAccount)
        {
            HasAccount = false;
            Console.WriteLine("Din konto er blevet lukket.");
        }
        else
        {
            Console.WriteLine("Du har ingen konto at lukke.");
        }
    }
}


