// SUPERMARKED
// -----------------------------------

public class Supermarket
{
    public string Name { get; set; }

    public Supermarket(string name)
    {
        Name = name;
    }

    public void ShowSupermarket()
    {
        Console.WriteLine($"Du er ved {Name}.");
    }
}


// -----------------------------------
// PROGRAM
// -----------------------------------

public class Program
{
    public static void Main()
    {
        // Bank er et objekt
        Bank bank = new Bank("Banken", 1000);

        // Supermarked er et objekt
        Supermarket supermarket = new Supermarket("Supermarkedet");

        bool running = true;

        while (running)
        {
            Console.WriteLine("================================");
            Console.WriteLine("              BANKEN");
            Console.WriteLine("================================");
            Console.WriteLine();

            Console.WriteLine("1. Opret bankkonto");
            Console.WriteLine("2. Se saldo");
            Console.WriteLine("3. Sæt penge ind");
            Console.WriteLine("4. Hæv penge");
            Console.WriteLine("5. Få bankkort");
            Console.WriteLine("6. Se bankkort");
            Console.WriteLine("7. Se konto");
            Console.WriteLine("8. Betal regning");
            Console.WriteLine("9. Luk konto");
            Console.WriteLine("10. Se lokationer");
            Console.WriteLine("11. Afslut");
            Console.WriteLine();

            Console.Write("Vælg en mulighed: ");

            string choice = Console.ReadLine() ?? "";

            Console.WriteLine();

            switch (choice)
            {
                case "1":
                    bank.CreateAccount();
                    break;

                case "2":
                    bank.CheckMoney();
                    break;

                case "3":
                    Console.Write("Hvor mange penge vil du sætte ind? ");

                    if (int.TryParse(Console.ReadLine(), out int deposit))
                    {
                        bank.Deposit(deposit);
                    }
                    else
                    {
                        Console.WriteLine("Du skal skrive et tal.");
                    }

                    break;

                case "4":
                    Console.Write("Hvor mange penge vil du hæve? ");

                    if (int.TryParse(Console.ReadLine(), out int withdraw))
                    {
                        bank.Withdraw(withdraw);
                    }
                    else
                    {
                        Console.WriteLine("Du skal skrive et tal.");
                    }

                    break;

                case "5":
                    bank.GetBankCard();
                    break;

                case "6":
                    bank.ShowBankCard();
                    break;

                case "7":
                    bank.ShowAccount();
                    break;

                case "8":
                    Console.Write("Hvor stor er regningen? ");

                    if (int.TryParse(Console.ReadLine(), out int bill))
                    {
                        bank.PayBill(bill);
                    }
                    else
                    {
                        Console.WriteLine("Du skal skrive et tal.");
                    }

                    break;

                case "9":
                    bank.CloseAccount();
                    break;

                case "10":
                    Console.WriteLine("Dine lokationer:");
                    Console.WriteLine();

                    Console.WriteLine("Bank:");
                    Console.WriteLine(bank.Name);

                    Console.WriteLine();

                    supermarket.ShowSupermarket();

                    break;

                case "11":
                    running = false;

                    Console.WriteLine("Tak for besøget i banken!");
                    break;

                default:
                    Console.WriteLine("Ugyldigt valg. Prøv igen.");
                    break;
            }

            if (running)
            {
                Console.WriteLine();
                Console.WriteLine("Tryk Enter for at fortsætte...");
                Console.ReadLine();
            }
        }
    }
}
