using System;
using System.Collections.Generic;

public class Resident
{
    public string Name { get; set; }
    public Location CurrentLocation { get; private set; }

    public List<string> Items { get; set; }

    public int Money { get; set; }

    public Resident(string name, int money)
    {
        Name = name;
        Money = money;

        Items = new List<string>
        {
            "Telefon",
            "Nøgle",
            "Bog"
        };
    }

    public void MoveTo(Location location)
    {
        CurrentLocation = location;

        Console.WriteLine();
        Console.WriteLine($"{Name} går til {location.Name}.");

        location.Interact(this);
    }

    public void AddItem(string item)
    {
        Items.Add(item);

        Console.WriteLine($"{Name} fik {item}.");
    }

    public void RemoveItem(string item)
    {
        if (Items.Contains(item))
        {
            Items.Remove(item);

            Console.WriteLine($"{Name} mistede {item}.");
        }
    }

    public void ShowInfo()
    {
        Console.WriteLine();
        Console.WriteLine($"--- {Name} ---");
        Console.WriteLine($"Penge: {Money} kr.");

        Console.WriteLine("Ting:");

        foreach (string item in Items)
        {
            Console.WriteLine($"- {item}");
        }
    }
}


// -----------------------------------
// LOCATION
// -----------------------------------

public class Location
{
    public string Name { get; set; }

    public Location(string name)
    {
        Name = name;
    }

    public virtual void Interact(Resident resident)
    {
        Console.WriteLine(
            $"{resident.Name} er ved {Name}."
        );
    }
}


// -----------------------------------
// BANK
// -----------------------------------

public class Bank : Location
{
    public Bank(string name) : base(name)
    {
    }

    public override void Interact(Resident resident)
    {
        Console.WriteLine(
            $"{resident.Name} går ind i banken."
        );

        Console.WriteLine(
            "Her kan du ordne dine penge."
        );
    }

    public void CheckMoney(Resident resident)
    {
        Console.WriteLine(
            $"{resident.Name} har {resident.Money} kr."
        );
    }

    public void Deposit(Resident resident, int amount)
    {
        resident.Money += amount;

        Console.WriteLine(
            $"{resident.Name} satte {amount} kr. ind."
        );
    }

    public void Withdraw(Resident resident, int amount)
    {
        if (resident.Money >= amount)
        {
            resident.Money -= amount;

            Console.WriteLine(
                $"{resident.Name} hævede {amount} kr."
            );
        }
        else
        {
            Console.WriteLine(
                $"{resident.Name} har ikke nok penge."
            );
        }
    }

    public void GetBankCard(Resident resident)
    {
        if (!resident.Items.Contains("Bankkort"))
        {
            resident.AddItem("Bankkort");
        }
        else
        {
            Console.WriteLine(
                $"{resident.Name} har allerede et bankkort."
            );
        }
    }

    public void TransferMoney(
        Resident from,
        Resident to,
        int amount)
    {
        if (from.Money >= amount)
        {
            from.Money -= amount;
            to.Money += amount;

            Console.WriteLine(
                $"{from.Name} sendte {amount} kr. " +
                $"til {to.Name}."
            );
        }
        else
        {
            Console.WriteLine(
                $"{from.Name} har ikke nok penge."
            );
        }
    }
}


