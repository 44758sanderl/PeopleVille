// -----------------------------------
// PROGRAM
// -----------------------------------

public class Program
{
    public static void Main()
    {
        Console.WriteLine(
            "================================"
        );

        Console.WriteLine(
            "       VELKOMMEN TIL LANDSBYEN"
        );

        Console.WriteLine(
            "================================"
        );


        // Steder i landsbyen

        Bank bank =
            new Bank("Banken");

        Supermarket supermarket =
            new Supermarket("Supermarkedet");

        Hospital hospital =
            new Hospital("Hospitalet");

        Restaurant restaurant =
            new Restaurant("Restauranten");

        School school =
            new School("Skolen");

        Park park =
            new Park("Parken");

        House house =
            new House("Peters hus");


        // Personer

        Resident peter =
            new Resident("Peter", 1000);

        Resident anna =
            new Resident("Anna", 700);


        // --------------------------------
        // PETER
        // --------------------------------

        Console.WriteLine();
        Console.WriteLine("========== PETER ==========");

        peter.MoveTo(bank);

        bank.CheckMoney(peter);

        bank.GetBankCard(peter);

        bank.Deposit(peter, 200);

        bank.Withdraw(peter, 100);

        bank.TransferMoney(
            peter,
            anna,
            200
        );


        peter.MoveTo(supermarket);

        supermarket.BuyFood(peter);


        peter.MoveTo(restaurant);

        restaurant.BuyFood(peter);


        peter.MoveTo(park);

        park.SitDown(peter);


        peter.MoveTo(school);

        school.Study(peter);


        peter.MoveTo(hospital);

        hospital.VisitDoctor(peter);


        peter.MoveTo(house);

        house.Sleep(peter);


        // --------------------------------
        // ANNA
        // --------------------------------

        Console.WriteLine();
        Console.WriteLine("========== ANNA ==========");

        anna.MoveTo(bank);

        bank.CheckMoney(anna);

        bank.GetBankCard(anna);


        anna.MoveTo(supermarket);

        supermarket.BuyFood(anna);


        anna.MoveTo(park);

        park.SitDown(anna);


        anna.MoveTo(restaurant);

        restaurant.BuyFood(anna);


        anna.MoveTo(house);

        house.Sleep(anna);


        // --------------------------------
        // SLUT
        // --------------------------------

        Console.WriteLine();
        Console.WriteLine(
            "========== SLUT =========="
        );

        peter.ShowInfo();

        anna.ShowInfo();

        Console.WriteLine();
        Console.WriteLine(
            "Tak for besøget i landsbyen!"
        );
    }
}